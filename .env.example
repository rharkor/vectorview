# Postgres connection string (database must have the pgvector extension)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vectorview

# Table / column names of your existing data
PG_TABLE=items
PG_ID_COLUMN=id
PG_EMBEDDING_COLUMN=embedding
# Optional integer/text column used to color points. Set empty to disable.
PG_CLUSTER_COLUMN=cluster

# Embedding model used for semantic search (must match the dimension of the
# stored embeddings, e.g. text-embedding-3-small -> 1536)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
